#version 460 core

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(binding = 0) uniform sampler2D CurrentFrame;
layout(binding = 1) uniform sampler2D PreviousFrame;
layout(binding = 2) uniform sampler2D MotionVectors;
layout(binding = 3, rgba8) uniform writeonly image2D OutGeneratedFrame;
// The reverse flow (previous frame to current, on the previous frame's pixels) when has_backward.
layout(binding = 4) uniform sampler2D BackwardMotion;

layout(push_constant) uniform PushConstants {
    vec2 inv_render_size;
    vec2 render_size;
    float blend_factor; // timestamp between 0.0 and 1.0
    float flow_scale;
    vec2 motion_scale; // sampled motion to texture coordinates
    float has_backward;
};

// ΓöÇΓöÇ Optimized 3├ù3 motion vector median using textureGather ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ
// textureGather fetches a 2├ù2 quad per call, so we only need 4 calls
// to cover a 3├ù3 neighbourhood (vs 9 individual texture() calls).
// We extract the median of X and Y components independently.
void insertionSort5(inout float a[5]) {
    for (int i = 1; i < 5; i++) {
        float key = a[i];
        int j = i - 1;
        while (j >= 0 && a[j] > key) {
            a[j + 1] = a[j];
            j--;
        }
        a[j + 1] = key;
    }
}

vec2 sampleMotionMedian(vec2 uv) {
    vec2 texel = 1.0 / vec2(textureSize(MotionVectors, 0));

    // textureGather returns 2├ù2 quads: (x-0.5, y-0.5) to (x+0.5, y+0.5)
    // We use 4 gathers offset to cover the 3├ù3 region
    // Gather component 0 = R (motion X), component 1 = G (motion Y)
    vec4 gx0 = textureGather(MotionVectors, uv + vec2(-0.5, -0.5) * texel, 0); // TL quad
    vec4 gx1 = textureGather(MotionVectors, uv + vec2( 0.5, -0.5) * texel, 0); // TR quad
    vec4 gx2 = textureGather(MotionVectors, uv + vec2(-0.5,  0.5) * texel, 0); // BL quad
    vec4 gx3 = textureGather(MotionVectors, uv + vec2( 0.5,  0.5) * texel, 0); // BR quad

    vec4 gy0 = textureGather(MotionVectors, uv + vec2(-0.5, -0.5) * texel, 1);
    vec4 gy1 = textureGather(MotionVectors, uv + vec2( 0.5, -0.5) * texel, 1);
    vec4 gy2 = textureGather(MotionVectors, uv + vec2(-0.5,  0.5) * texel, 1);
    vec4 gy3 = textureGather(MotionVectors, uv + vec2( 0.5,  0.5) * texel, 1);

    // Extract 9 unique samples from overlapping 2├ù2 quads
    // gatherN.w=TL, .z=TR, .x=BL, .y=BR of each quad
    // 3├ù3 grid: row0=[gx0.w, gx0.z/gx1.w, gx1.z]
    //           row1=[gx0.x/gx2.w, center, gx1.y/gx3.z]
    //           row2=[gx2.x, gx2.y/gx3.x, gx3.y]
    float xs[9] = float[](gx0.w, gx1.w, gx1.z, gx0.x, texture(MotionVectors, uv).x, gx1.y, gx2.x, gx3.x, gx3.y);
    float ys[9] = float[](gy0.w, gy1.w, gy1.z, gy0.x, texture(MotionVectors, uv).y, gy1.y, gy2.x, gy3.x, gy3.y);

    // Partial sort: only need to find element [4] (median)
    // Use two passes of 5-element insertion sort on the lower half
    float xlo[5] = float[](xs[0], xs[1], xs[2], xs[3], xs[4]);
    float ylo[5] = float[](ys[0], ys[1], ys[2], ys[3], ys[4]);
    insertionSort5(xlo);
    insertionSort5(ylo);

    // Insert remaining 4 elements, keeping only the 5 smallest
    for (int i = 5; i < 9; i++) {
        if (xs[i] < xlo[4]) { xlo[4] = xs[i]; insertionSort5(xlo); }
        if (ys[i] < ylo[4]) { ylo[4] = ys[i]; insertionSort5(ylo); }
    }

    return vec2(xlo[4], ylo[4]);
}

float frameChange(vec2 uv) {
    vec3 difference = abs(texture(PreviousFrame, uv).rgb - texture(CurrentFrame, uv).rgb);
    return dot(difference, vec3(0.333));
}

float staticWeight(vec2 uv) {
    return 1.0 - smoothstep(0.01, 0.03, frameChange(uv));
}

// The current-to-previous motion of the previous frame's content at `uv`.
vec2 previousFrameMotion(vec2 uv) {
    return has_backward > 0.5 ? -texture(BackwardMotion, uv).xy * motion_scale
                              : texture(MotionVectors, uv).xy * motion_scale;
}

// 1 where `there` (the motion of what a sample lands on) matches `motion` (both in texture
// coordinates), falling to 0 beyond a few pixels of difference.
float motionConsistency(vec2 there, vec2 motion) {
    float difference = length((there - motion) * render_size);
    // Flow is noisier for larger motions.
    float tolerance = 1.0 + 0.04 * length(motion * render_size);
    return 1.0 - smoothstep(tolerance, 3.0 * tolerance, difference);
}

// How badly the two frames disagree around `uv` if it moved by `motion` between them.
float matchError(vec2 uv, vec2 motion) {
    vec2 previous_uv = uv + motion * blend_factor;
    vec2 current_uv = uv - motion * (1.0 - blend_factor);
    const vec2 offsets[5] = vec2[](vec2(0.0), vec2(-2.0, 0.0), vec2(2.0, 0.0), vec2(0.0, -2.0),
                                   vec2(0.0, 2.0));
    float error = 0.0;
    for (int i = 0; i < 5; ++i) {
        vec2 offset = offsets[i] * inv_render_size;
        vec3 difference = abs(texture(PreviousFrame, previous_uv + offset).rgb -
                              texture(CurrentFrame, current_uv + offset).rgb);
        error += dot(difference, vec3(0.333));
    }
    // Samples from outside the frame only repeat its edge.
    bool outside = any(notEqual(previous_uv, clamp(previous_uv, 0.0, 1.0))) ||
                   any(notEqual(current_uv, clamp(current_uv, 0.0, 1.0)));
    return error + (outside ? 0.5 : 0.0);
}

void main() {
    ivec2 pixel_coord = ivec2(gl_GlobalInvocationID.xy);
    if (pixel_coord.x >= int(render_size.x) || pixel_coord.y >= int(render_size.y)) {
        return;
    }

    vec2 uv = (vec2(pixel_coord) + 0.5) * inv_render_size;

    // Median-filtered motion vector (reduces outlier jitter)
    // Candidate motions: the median and the raw vectors here and two flow cells away. At an
    // object's edge the median mixes its motion with the background's (a halo around a figure the
    // camera follows); the candidate under which both frames agree belongs to this pixel.
    vec2 motion_texel = 1.0 / vec2(textureSize(MotionVectors, 0));
    // With the reverse flow, the previous frame's motions here are candidates too: where the
    // background appears from behind something, only that frame has it.
    vec2 candidates[9] = vec2[](
        sampleMotionMedian(uv) * motion_scale, texture(MotionVectors, uv).xy * motion_scale,
        texture(MotionVectors, uv + vec2(-2.0, 0.0) * motion_texel).xy * motion_scale,
        texture(MotionVectors, uv + vec2(2.0, 0.0) * motion_texel).xy * motion_scale,
        texture(MotionVectors, uv + vec2(0.0, -2.0) * motion_texel).xy * motion_scale,
        texture(MotionVectors, uv + vec2(0.0, 2.0) * motion_texel).xy * motion_scale,
        previousFrameMotion(uv),
        previousFrameMotion(uv + vec2(-2.0, 0.0) * motion_texel),
        previousFrameMotion(uv + vec2(2.0, 0.0) * motion_texel));
    vec2 motion = candidates[0];
    float best_error = matchError(uv, motion);
    for (int i = 1; i < 9; ++i) {
        vec2 candidate = candidates[i];
        float error = matchError(uv, candidate);
        if (error < best_error * 0.9) {
            best_error = error;
            motion = candidate;
        }
    }

    // Forward and backward warped coordinates
    vec2 forward_raw  = uv + motion * blend_factor;
    vec2 backward_raw = uv - motion * (1.0 - blend_factor);
    vec2 forward_uv  = clamp(forward_raw,  0.0, 1.0);
    vec2 backward_uv = clamp(backward_raw, 0.0, 1.0);
    // A sample from outside the frame (motion off screen) would smear its edge.
    float forward_inside  = forward_raw == forward_uv ? 1.0 : 0.0;
    float backward_inside = backward_raw == backward_uv ? 1.0 : 0.0;

    vec4 forward_color  = texture(PreviousFrame, forward_uv);
    vec4 backward_color = texture(CurrentFrame,  backward_uv);

    // Colour-difference occlusion
    vec3 color_diff = abs(forward_color.rgb - backward_color.rgb);
    float occlusion = clamp(dot(color_diff, vec3(0.333)) * 2.0, 0.0, 1.0);

    // Smooth bilateral interpolation ΓÇö bias toward centre on occlusion
    float alpha = mix(blend_factor, 0.5, occlusion * 0.4);
    vec4 interpolated = mix(forward_color, backward_color, alpha);

    // Static pixels (HUD over a moving scene): unchanged between the frames, here and around.
    // A moving pixel ignores a warped sample that lands on one, else the HUD is copied along the
    // flow of what moves behind it.
    float change = 0.0;
    const vec2 cross_offsets[5] = vec2[](vec2(0.0), vec2(-1.0, 0.0), vec2(1.0, 0.0),
                                         vec2(0.0, -1.0), vec2(0.0, 1.0));
    for (int i = 0; i < 5; ++i) {
        change = max(change, frameChange(uv + cross_offsets[i] * inv_render_size));
    }
    float moving = smoothstep(0.01, 0.03, change);
    // A sample is only trusted where the flow moves the way this pixel does: beside something
    // the camera follows, the background's motion makes one sample land on it (still on screen)
    // and blending that in leaves a copy of it half the motion away on each side.
    // Each sample is checked against its own frame's flow: the previous frame's content where
    // the previous sample lands, the current frame's where the current one does.
    float forward_consistent = motionConsistency(previousFrameMotion(forward_uv), motion);
    float backward_consistent =
        motionConsistency(texture(MotionVectors, backward_uv).xy * motion_scale, motion);
    float forward_weight = (1.0 - alpha) * (1.0 - moving * staticWeight(forward_uv)) *
                           forward_inside * (forward_consistent + 0.01);
    float backward_weight = alpha * (1.0 - moving * staticWeight(backward_uv)) *
                            backward_inside * (backward_consistent + 0.01);
    vec4 center_color = mix(texture(PreviousFrame, uv), texture(CurrentFrame, uv), blend_factor);
    if (forward_weight + backward_weight > 1e-3) {
        interpolated = (forward_color * forward_weight + backward_color * backward_weight) /
                       (forward_weight + backward_weight);
    } else {
        interpolated = center_color;
    }

    // ΓöÇΓöÇ Anti-flicker: blend with un-warped centre pixel ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ
    float motion_magnitude = length(motion * render_size);
    float direct_weight = exp(-motion_magnitude * 0.5);
    interpolated = mix(interpolated, center_color, direct_weight * 0.3);
    // Unchanged pixels stay where they are.
    interpolated = mix(interpolated, center_color, 1.0 - moving);

    imageStore(OutGeneratedFrame, pixel_coord, interpolated);
}
